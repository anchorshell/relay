RELAY_HTTP_ADDR=:11730
RELAY_DB_PATH=./relay.db

# Admin API/dashboard token.
# Auto-generated into .env on first run if missing.
# Or generate manually with: openssl rand -base64 32
RELAY_ADMIN_TOKEN=
# Optional. Change this when running multiple Relay-derived dev apps on the same host.
RELAY_ADMIN_COOKIE_NAME=relay_admin_token

# Inference API key for /v1/* (separate from the management token).
# Omit the setting to generate and persist a secure token on startup.
# The commented line below is intentional: uncommenting an EMPTY assignment
# disables inference authentication. Use only in controlled environments.
# RELAY_API_TOKEN=

# 32-byte base64 AES-256-GCM encryption key.
# Auto-generated into .env on first run if missing.
# Or generate manually with: openssl rand -base64 32
# Losing this key means encrypted provider credentials cannot be recovered.
RELAY_MASTER_KEY=

RELAY_INSECURE_DEV=false
RELAY_LOG_LEVEL=info
RELAY_TEMP_DIR=./tmp
RELAY_DEFAULT_MAX_WAIT_MS=30000
RELAY_DEFAULT_MAX_LATENCY_MS=600000
RELAY_MAX_QUEUE_LENGTH=1000
RELAY_MAX_QUEUE_AGE_MS=300000
RELAY_BODY_MEMORY_THRESHOLD_BYTES=1048576
RELAY_BODY_SPOOL_THRESHOLD_BYTES=8388608
RELAY_UPSTREAM_MAX_IDLE_CONNS=1024
RELAY_UPSTREAM_MAX_IDLE_CONNS_PER_HOST=512
RELAY_UPSTREAM_IDLE_CONN_TIMEOUT=90s
CHARACTERIZATION_ENABLED=true
CHARACTERIZATION_WORKERS=1
CHARACTERIZATION_QUEUE_SIZE=128
CHARACTERIZATION_JOB_TIMEOUT=25ms
CHARACTERIZATION_TERMINAL_WAIT=5ms
CHARACTERIZATION_STRICT_MODEL=false

# Bounded operational caches. Partitioned runtimes use the runtime settings;
# standalone OSS keeps its one scheduler for the process lifetime.
ANCHORSHELL_RUNTIME_IDLE_TTL=10m
ANCHORSHELL_RUNTIME_SWEEP_INTERVAL=1m
ANCHORSHELL_RUNTIME_CHECKPOINT_FLUSH_TIMEOUT=30s
ANCHORSHELL_CATALOG_CACHE_MAX_ENTRIES=10000
ANCHORSHELL_CATALOG_CACHE_MAX_BYTES=67108864
ANCHORSHELL_CATALOG_CACHE_IDLE_TTL=15m
ANCHORSHELL_ENDPOINT_HEALTH_CACHE_MAX_ENTRIES=10000
ANCHORSHELL_ENDPOINT_HEALTH_CACHE_IDLE_TTL=15m
ANCHORSHELL_CREDENTIAL_CACHE_MAX_ENTRIES=10000
ANCHORSHELL_CREDENTIAL_CACHE_MAX_BYTES=8388608
ANCHORSHELL_CREDENTIAL_CACHE_IDLE_TTL=15m
ANCHORSHELL_WS_SNAPSHOT_CACHE_MAX_ENTRIES=512
ANCHORSHELL_WS_SNAPSHOT_CACHE_MAX_BYTES=33554432
ANCHORSHELL_WS_SNAPSHOT_CACHE_TTL=5m

# Optional vendor-neutral OpenTelemetry tracing over OTLP/HTTP.
# Empty leaves tracing disabled. Local SigNoz Community Edition listens on 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=anchorshell-relay
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.instance.id=relay-local
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05
# Placeholder SQL only; bound values are never included. Prefer false.
OTEL_DB_STATEMENT_ENABLED=false
# Optional Laya worker. Leave unset for the existing lightweight default.
# See docs/LAYA.md. Configure a measured positive deadline (maximum 30s).
# RELAY_LAYA_URL=http://127.0.0.1:11731
# RELAY_LAYA_TIMEOUT=2s
# RELAY_LAYA_TOKEN=
